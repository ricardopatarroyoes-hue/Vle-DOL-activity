                <!-- Rainy Bucket -->
                <button onclick="sortItem('rainy')" class="game-card bg-gradient-to-b from-sky-200 to-blue-400 border-4 border-sky-400 p-4 rounded-3xl text-center flex flex-col items-center justify-center space-y-2 group hover:bg-sky-300">
                    <span class="text-4xl group-hover:scale-110 transition-transform">🌧️</span>
                    <span class="font-black text-blue-950 text-lg">Rainy Day</span>
                    <span class="text-xs font-bold text-blue-800 bg-white/60 px-3 py-1 rounded-full">Tap or Drop Here</span>
                </button>
            </div>
        </section>


        <!-- ================= PAGE 3: ACTIVITY 2 - DRESS THE CHARACTER ================= -->
        <section id="view-act2" class="hidden space-y-4">
            <!-- Header bar for activity 2 -->
            <div class="flex items-center justify-between bg-white/80 p-3 rounded-2xl border-2 border-white">
                <button onclick="goToHome()" class="px-3 py-1 bg-gray-200 hover:bg-gray-300 rounded-xl font-bold text-xs text-gray-700 flex items-center space-x-1">
                    <i class="fa-solid fa-arrow-left"></i> <span>Menu</span>
                </button>
                <div class="text-center">
                    <h2 class="font-black text-lg text-gray-800">Activity 2: Dress Leo! 🧍</h2>
                    <p class="text-xs font-semibold text-gray-600">Pick 3 correct clothing items for Leo!</p>
                </div>
                <div class="text-xs font-bold text-sky-700 bg-sky-100 px-3 py-1 rounded-xl">
                    Selected: <span id="act2-selected-count">0</span>/3
                </div>
            </div>

            <!-- Scenario Title Box -->
            <div class="bg-white/90 p-4 rounded-2xl border-2 border-white text-center shadow-md flex items-center justify-between">
                <div class="flex items-center space-x-3 text-left">
                    <span id="act2-weather-icon" class="text-4xl">☀️</span>
                    <div>
                        <h3 id="act2-prompt" class="font-extrabold text-lg text-gray-800">It is sunny today! What should Leo wear?</h3>
                        <p class="text-xs text-gray-500">Tap 3 items to complete the outfit.</p>
                    </div>
                </div>
                <button id="act2-speaker" onclick="speakCurrentPrompt()" class="p-3 bg-amber-200 hover:bg-amber-300 rounded-2xl text-amber-800 font-bold text-sm">
                    <i class="fa-solid fa-volume-high text-lg"></i>
                </button>
            </div>

            <!-- Dressing Area Layout: Character + Wardrobe -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <!-- Character Display Box -->
                <div class="bg-white/70 p-4 rounded-3xl border-4 border-white flex flex-col items-center justify-center text-center shadow-inner min-h-[220px]">
                    <div id="act2-character" class="text-7xl mb-2 relative">
                        🧍
                        <div id="act2-outfit-preview" class="text-3xl absolute -bottom-2 -right-2 flex"></div>
                    </div>
                    <p id="act2-char-status" class="font-black text-sm text-gray-700 mt-2">Leo is waiting for clothes...</p>
                    <div id="act2-slots" class="flex gap-2 mt-3">
                        <div class="w-10 h-10 rounded-xl bg-gray-200/80 border-2 border-dashed border-gray-400 flex items-center justify-center text-xl slot-0">❓</div>
                        <div class="w-10 h-10 rounded-xl bg-gray-200/80 border-2 border-dashed border-gray-400 flex items-center justify-center text-xl slot-1">❓</div>
                        <div class="w-10 h-10 rounded-xl bg-gray-200/80 border-2 border-dashed border-gray-400 flex items-center justify-center text-xl slot-2">❓</div>
                    </div>
                </div>

                <!-- Wardrobe Options (6 Items Grid) -->
                <div id="act2-options-grid" class="md:col-span-2 grid grid-cols-3 gap-3">
                    <!-- Dynamic wardrobe items rendered via JavaScript -->
                </div>
            </div>

            <!-- Submit Outfit Button -->
            <div class="text-center pt-2">
                <button id="act2-submit-btn" onclick="checkAct2Outfit()" disabled class="px-8 py-3 bg-gray-300 text-gray-500 font-black rounded-2xl text-lg shadow-md transition-all">
                    Check Leo's Outfit! 🌟
                </button>
            </div>
        </section>


        <!-- ================= PAGE 4: ACTIVITY 3 - QUIZ MASTER ================= -->
        <section id="view-act3" class="hidden space-y-4">
            <!-- Header bar for activity 3 -->
            <div class="flex items-center justify-between bg-white/80 p-3 rounded-2xl border-2 border-white">
                <button onclick="goToHome()" class="px-3 py-1 bg-gray-200 hover:bg-gray-300 rounded-xl font-bold text-xs text-gray-700 flex items-center space-x-1">
                    <i class="fa-solid fa-arrow-left"></i> <span>Menu</span>
                </button>
                <div class="text-center">
                    <h2 class="font-black text-lg text-gray-800">Activity 3: Quiz Master 🧩</h2>
                    <p class="text-xs font-semibold text-gray-600">Complete the English sentences!</p>
                </div>
                <div class="text-xs font-bold text-teal-700 bg-teal-100 px-3 py-1 rounded-xl">
                    Question: <span id="act3-q-num">1</span>/<span id="act3-q-total">5</span>
                </div>
            </div>

            <!-- Question Card -->
            <div class="bg-white/90 p-6 rounded-3xl border-4 border-white shadow-xl text-center space-y-4 max-w-2xl mx-auto">
                <div class="flex items-center justify-center space-x-2">
                    <button onclick="speakAct3Question()" class="p-3 bg-emerald-100 hover:bg-emerald-200 rounded-2xl text-emerald-800 font-bold">
                        <i class="fa-solid fa-volume-high text-xl"></i>
                    </button>
                    <span id="act3-weather-badge" class="px-3 py-1 bg-yellow-100 text-yellow-800 font-bold text-xs rounded-full">
                        Sunny Weather
                    </span>
                </div>

                <div id="act3-sentence" class="text-2xl md:text-3xl font-black text-gray-800 leading-snug">
                    "On a sunny day, I wear my <span class="border-b-4 border-dashed border-amber-500 px-2 text-amber-600">______</span>."
                </div>

                <!-- 4 Visual Option Cards -->
                <div id="act3-options" class="grid grid-cols-2 gap-4 pt-4">
                    <!-- Rendered dynamically -->
                </div>
            </div>
        </section>


        <!-- ================= PAGE 5: SUMMARY & TEACHER PANEL ================= -->
        <section id="view-summary" class="hidden space-y-6 text-center">
            <div class="bg-white/90 backdrop-blur-md p-6 md:p-8 rounded-3xl border-4 border-white shadow-2xl max-w-2xl mx-auto relative overflow-hidden">
                <div class="text-6xl mb-2">🏆</div>
                <h2 class="text-3xl font-extrabold text-gray-800">Adventure Completed!</h2>
                <p class="text-gray-600 text-sm mb-6">Great job practicing English weather & clothes!</p>

                <!-- Final Stats Grid -->
                <div class="grid grid-cols-3 gap-3 bg-amber-50 p-4 rounded-2xl border-2 border-amber-200 mb-6">
                    <div>
                        <div class="text-xs text-gray-500 font-bold">TOTAL SCORE</div>
                        <div id="summary-score" class="text-2xl font-black text-amber-600">0 pts</div>
                    </div>
                    <div>
                        <div class="text-xs text-gray-500 font-bold">STARS EARNED</div>
                        <div id="summary-stars" class="text-2xl font-black text-yellow-500">⭐ 0</div>
                    </div>
                    <div>
                        <div class="text-xs text-gray-500 font-bold">ACCURACY</div>
                        <div id="summary-accuracy" class="text-2xl font-black text-emerald-600">100%</div>
                    </div>
                </div>

                <!-- Teacher Feedback & Learning Insights -->
                <div class="text-left bg-sky-50 p-4 rounded-2xl border-2 border-sky-200 mb-6 space-y-2">
                    <div class="flex items-center space-x-2 text-sky-900 font-extrabold text-sm">
                        <i class="fa-solid fa-apple-whole text-red-500 text-base"></i>
                        <span>Teacher Insights & Mastery Report</span>
                    </div>
                    <p id="teacher-feedback-text" class="text-xs text-gray-700 leading-relaxed">
                        The student demonstrated strong recognition of sunny weather items (T-shirt, Sunglasses, Shorts) and rainy weather items (Raincoat, Umbrella, Rain boots).
                    </p>
                    <div id="retried-items-box" class="hidden text-xs bg-white p-2 rounded-xl border border-sky-200 text-sky-800">
                        <strong>Reviewed & Mastered Items:</strong> <span id="retried-words-list"></span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-wrap gap-3 justify-center">
                    <button onclick="goToHome()" class="px-6 py-3 bg-amber-400 hover:bg-amber-300 text-amber-950 font-black rounded-2xl shadow-md text-base transition-all">
                        🏠 Main Menu
                    </button>
                    <button onclick="resetAppStats()" class="px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold rounded-2xl shadow-sm text-base transition-all">
                        🔄 Play Again
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- Custom Feedback Toast Modal -->
    <div id="feedback-toast" class="fixed top-20 left-1/2 transform -translate-x-1/2 z-50 pointer-events-none transition-all duration-300 opacity-0 scale-90">
        <div id="toast-content" class="px-6 py-3 rounded-2xl border-4 font-black text-lg shadow-2xl flex items-center space-x-3 bg-white">
            <span id="toast-icon" class="text-2xl">🎉</span>
            <span id="toast-message">Great job!</span>
        </div>
    </div>

    <!-- Footer -->
    <footer class="relative z-10 w-full text-center py-3 text-xs text-gray-600 font-semibold">
        Weather & Clothes Kids Adventure • EFL English Grade 2-3
    </footer>

    <!-- JavaScript Application Logic -->
    <script>
        /* ==================== GLOBAL APP STATE ==================== */
        const gameState = {
            score: 0,
            stars: 0,
            streak: 0,
            totalAttempts: 0,
            correctAttempts: 0,
            currentActivity: 0,
            incorrectQueue: [], // Repetition queue for wrong items
            masteredWords: new Set()
        };

        /* Vocabulary Data Sets */
        const vocabulary = [
            { id: 'tshirt', word: 'T-shirt', emoji: '👕', category: 'sunny' },
            { id: 'sunglasses', word: 'Sunglasses', emoji: '🕶️', category: 'sunny' },
            { id: 'shorts', word: 'Shorts', emoji: '🩳', category: 'sunny' },
            { id: 'sunhat', word: 'Sun hat', emoji: '👒', category: 'sunny' },
            { id: 'sandals', word: 'Sandals', emoji: '👡', category: 'sunny' },
            { id: 'cap', word: 'Cap', emoji: '🧢', category: 'sunny' },
            { id: 'raincoat', word: 'Raincoat', emoji: '🧥', category: 'rainy' },
            { id: 'rainboots', word: 'Rain boots', emoji: '🥾', category: 'rainy' },
            { id: 'umbrella', word: 'Umbrella', emoji: '☂️', category: 'rainy' },
            { id: 'sweater', word: 'Sweater', emoji: '🧶', category: 'rainy' },
            { id: 'jacket', word: 'Jacket', emoji: '🧥', category: 'rainy' }
        ];

        /* Activity 1 State */
        let act1List = [];
        let currentAct1Index = 0;
        let currentAct1Item = null;

        /* Activity 2 State */
        let act2Weather = 'sunny'; // 'sunny' or 'rainy'
        let act2Options = [];
        let act2SelectedItems = [];

        /* Activity 3 State */
        const act3Questions = [
            {
                weather: 'sunny',
                sentence: "On a sunny day, I wear my ____.",
                blankText: "T-shirt",
                options: [
                    { word: 'T-shirt', emoji: '👕', correct: true },
                    { word: 'Raincoat', emoji: '🧥', correct: false },
                    { word: 'Rain boots', emoji: '🥾', correct: false },
                    { word: 'Umbrella', emoji: '☂️', correct: false }
                ]
            },
            {
                weather: 'rainy',
                sentence: "When it rains, I need my ____!",
                blankText: "Umbrella",
                options: [
                    { word: 'Sunglasses', emoji: '🕶️', correct: false },
                    { word: 'Umbrella', emoji: '☂️', correct: true },
                    { word: 'Shorts', emoji: '🩳', correct: false },
                    { word: 'Sandals', emoji: '👡', correct: false }
                ]
            },
            {
                weather: 'sunny',
                sentence: "It is hot and sunny! Put on your ____.",
                blankText: "Sunglasses",
                options: [
                    { word: 'Sweater', emoji: '🧶', correct: false },
                    { word: 'Rain boots', emoji: '🥾', correct: false },
                    { word: 'Sunglasses', emoji: '🕶️', correct: true },
                    { word: 'Raincoat', emoji: '🧥', correct: false }
                ]
            },
            {
                weather: 'rainy',
                sentence: "Keep your feet dry with ____.",
                blankText: "Rain boots",
                options: [
                    { word: 'Sandals', emoji: '👡', correct: false },
                    { word: 'Rain boots', emoji: '🥾', correct: true },
                    { word: 'Cap', emoji: '🧢', correct: false },
                    { word: 'Shorts', emoji: '🩳', correct: false }
                ]
            },
            {
                weather: 'sunny',
                sentence: "To protect your eyes from the sun, wear a ____.",
                blankText: "Sun hat",
                options: [
                    { word: 'Sun hat', emoji: '👒', correct: true },
                    { word: 'Raincoat', emoji: '🧥', correct: false },
                    { word: 'Sweater', emoji: '🧶', correct: false },
                    { word: 'Jacket', emoji: '🧥', correct: false }
                ]
            }
        ];
        let currentAct3Index = 0;

        /* ==================== WEB AUDIO SYNTHESIZER ==================== */
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playSound(type) {
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            const now = audioCtx.currentTime;

            if (type === 'correct') {
                // Happy Arpeggio (C5 -> E5 -> G5)
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(523.25, now); // C5
                osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
                osc.frequency.setValueAtTime(783.99, now + 0.2); // G5
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
                osc.start(now);
                osc.stop(now + 0.4);
            } else if (type === 'wrong') {
                // Low Buzz / Boing tone
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, now);
                osc.frequency.exponentialRampToValueAtTime(110, now + 0.3);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                osc.start(now);
                osc.stop(now + 0.3);
            } else if (type === 'click') {
                // Subtle tap
                osc.type = 'sine';
                osc.frequency.setValueAtTime(400, now);
                gain.gain.setValueAtTime(0.1, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);
                osc.start(now);
                osc.stop(now + 0.05);
            } else if (type === 'fanfare') {
                // Celebration Chords
                [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
                    const noteOsc = audioCtx.createOscillator();
                    const noteGain = audioCtx.createGain();
                    noteOsc.connect(noteGain);
                    noteGain.connect(audioCtx.destination);
                    noteOsc.type = 'triangle';
                    noteOsc.frequency.setValueAtTime(freq, now + (idx * 0.12));
                    noteGain.gain.setValueAtTime(0.2, now + (idx * 0.12));
                    noteGain.gain.exponentialRampToValueAtTime(0.01, now + (idx * 0.12) + 0.5);
                    noteOsc.start(now + (idx * 0.12));
                    noteOsc.stop(now + (idx * 0.12) + 0.5);
                });
            }
        }

        /* ==================== TEXT TO SPEECH ==================== */
        function speakWord(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel(); // Stop ongoing speech
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'en-US';
                utterance.rate = 0.85; // Slightly slower for children
                utterance.pitch = 1.1; // Friendly pitch
                window.speechSynthesis.speak(utterance);
            }
        }

        /* ==================== THEME MANAGEMENT ==================== */
        function setTheme(theme) {
            const body = document.body;
            const rainContainer = document.getElementById('rain-container');
            const sunContainer = document.getElementById('sun-container');

            body.classList.remove('theme-sunny', 'theme-rainy', 'theme-neutral');
            rainContainer.classList.add('hidden');
            sunContainer.classList.add('hidden');

            if (theme === 'sunny') {
                body.classList.add('theme-sunny');
                sunContainer.classList.remove('hidden');
            } else if (theme === 'rainy') {
                body.classList.add('theme-rainy');
                rainContainer.classList.remove('hidden');
                generateRain();
            } else {
                body.classList.add('theme-neutral');
            }
        }

        function generateRain() {
            const container = document.getElementById('rain-container');
            container.innerHTML = '';
            for (let i = 0; i < 25; i++) {
                const drop = document.createElement('div');
                drop.className = 'rain-drop';
                drop.style.left = `${Math.random() * 100}%`;
                drop.style.animationDuration = `${0.6 + Math.random() * 0.6}s`;
                drop.style.animationDelay = `${Math.random() * 2}s`;
                container.appendChild(drop);
            }
        }

        /* ==================== NAVIGATION ==================== */
        function showView(viewId) {
            ['view-home', 'view-act1', 'view-act2', 'view-act3', 'view-summary'].forEach(id => {
                document.getElementById(id).classList.add('hidden');
            });
            document.getElementById(viewId).classList.remove('hidden');
        }

        function goToHome() {
            playSound('click');
            setTheme('neutral');
            showView('view-home');
        }

        /* ==================== GAMIFICATION FEEDBACK ==================== */
        function updateScoreBoard() {
            document.getElementById('score-count').innerText = `${gameState.score} pts`;
            document.getElementById('star-count').innerText = gameState.stars;
            document.getElementById('streak-count').innerText = `${gameState.streak}x`;
        }

        function showFeedbackToast(isCorrect, text) {
            const toast = document.getElementById('feedback-toast');
            const content = document.getElementById('toast-content');
            const icon = document.getElementById('toast-icon');
            const message = document.getElementById('toast-message');

            message.innerText = text;

            if (isCorrect) {
                content.className = "px-6 py-3 rounded-2xl border-4 border-emerald-400 bg-emerald-100 text-emerald-900 font-black text-lg shadow-2xl flex items-center space-x-3";
                icon.innerText = "🌟";
            } else {
                content.className = "px-6 py-3 rounded-2xl border-4 border-rose-400 bg-rose-100 text-rose-900 font-black text-lg shadow-2xl flex items-center space-x-3";
                icon.innerText = "💡";
            }

            toast.classList.remove('opacity-0', 'scale-90');
            toast.classList.add('opacity-100', 'scale-100');

            setTimeout(() => {
                toast.classList.remove('opacity-100', 'scale-100');
                toast.classList.add('opacity-0', 'scale-90');
            }, 1600);
        }

        function recordAnswer(isCorrect, itemWord = '') {
            gameState.totalAttempts++;
            if (isCorrect) {
                gameState.correctAttempts++;
                gameState.score += 10 + (gameState.streak * 2);
                gameState.streak++;
                if (gameState.streak % 3 === 0) {
                    gameState.stars++;
                }
                playSound('correct');
            } else {
                gameState.streak = 0;
                playSound('wrong');
                if (itemWord) {
                    gameState.incorrectQueue.push(itemWord);
                }
            }
            updateScoreBoard();
        }

        /* ==================== ACTIVITY 1 LOGIC ==================== */
        function startActivity(actNumber) {
            playSound('click');
            gameState.currentActivity = actNumber;

            if (actNumber === 1) {
                // Prepare Activity 1 items (shuffle)
                act1List = [...vocabulary].sort(() => Math.random() - 0.5);
                currentAct1Index = 0;
                showView('view-act1');
                loadAct1Item();
            } else if (actNumber === 2) {
                showView('view-act2');
                setupAct2Round();
            } else if (actNumber === 3) {
                currentAct3Index = 0;
                showView('view-act3');
                loadAct3Question();
            }
        }

        function loadAct1Item() {
            if (currentAct1Index >= act1List.length) {
                // If there are incorrect items queued, retry them!
                if (gameState.incorrectQueue.length > 0) {
                    const retryWords = [...new Set(gameState.incorrectQueue)];
                    gameState.incorrectQueue = []; // Reset queue
                    act1List = vocabulary.filter(v => retryWords.includes(v.word));
                    currentAct1Index = 0;
                    showFeedbackToast(false, "Let's try the ones we missed! 🔄");
                } else {
                    finishActivity();
                    return;
                }
            }

            currentAct1Item = act1List[currentAct1Index];
            setTheme(currentAct1Item.category);

            document.getElementById('act1-emoji').innerText = currentAct1Item.emoji;
            document.getElementById('act1-title').innerText = currentAct1Item.word;
            document.getElementById('act1-remaining').innerText = act1List.length - currentAct1Index;

            // Update Progress Bar
            const progPercent = (currentAct1Index / act1List.length) * 100;
            document.getElementById('act1-progress').style.width = `${progPercent}%`;

            // Speak word automatically
            speakWord(currentAct1Item.word);
        }

        function sortItem(selectedCategory) {
            const isCorrect = (selectedCategory === currentAct1Item.category);

            if (isCorrect) {
                showFeedbackToast(true, `Correct! ${currentAct1Item.word} is for ${selectedCategory} days!`);
                gameState.masteredWords.add(currentAct1Item.word);
                recordAnswer(true);
            } else {
                showFeedbackToast(false, `Oops! ${currentAct1Item.word} belongs in ${currentAct1Item.category} days.`);
                recordAnswer(false, currentAct1Item.word);
            }

            currentAct1Index++;
            setTimeout(loadAct1Item, 1200);
        }


        /* ==================== ACTIVITY 2 LOGIC ==================== */
        function setupAct2Round() {
            act2Weather = Math.random() > 0.5 ? 'sunny' : 'rainy';
            setTheme(act2Weather);

            const promptEl = document.getElementById('act2-prompt');
            const iconEl = document.getElementById('act2-weather-icon');
            const speakerBtn = document.getElementById('act2-speaker');

            if (act2Weather === 'sunny') {
                promptEl.innerText = "It is sunny and hot today! What should Leo wear?";
                iconEl.innerText = "☀️";
                speakerBtn.className = "p-3 bg-amber-200 hover:bg-amber-300 rounded-2xl text-amber-900 font-bold";
            } else {
                promptEl.innerText = "It is raining outside today! What should Leo wear?";
                iconEl.innerText = "🌧️";
                speakerBtn.className = "p-3 bg-sky-200 hover:bg-sky-300 rounded-2xl text-sky-900 font-bold";
            }

            // Pick 3 correct matching items and 3 distractor items
            const correctCategoryItems = vocabulary.filter(v => v.category === act2Weather).sort(() => Math.random() - 0.5).slice(0, 3);
            const otherCategoryItems = vocabulary.filter(v => v.category !== act2Weather).sort(() => Math.random() - 0.5).slice(0, 3);
            
            act2Options = [...correctCategoryItems, ...otherCategoryItems].sort(() => Math.random() - 0.5);
            act2SelectedItems = [];

            updateAct2SlotsUI();
            renderAct2Options();
            speakCurrentPrompt();
        }

        function speakCurrentPrompt() {
            const promptText = document.getElementById('act2-prompt').innerText;
            speakWord(promptText);
        }

        function renderAct2Options() {
            const grid = document.getElementById('act2-options-grid');
            grid.innerHTML = '';

            act2Options.forEach(item => {
                const isSelected = act2SelectedItems.some(i => i.id === item.id);
                const card = document.createElement('button');
                card.onclick = () => toggleAct2Selection(item);
                card.className = `game-card p-3 rounded-2xl border-4 text-center flex flex-col items-center justify-center transition-all ${
                    isSelected 
                    ? 'bg-amber-200 border-amber-500 scale-95 shadow-inner' 
                    : 'bg-white border-white hover:border-amber-200'
                }`;

                card.innerHTML = `
                    <div class="text-4xl mb-1">${item.emoji}</div>
                    <div class="font-bold text-xs text-gray-800">${item.word}</div>
                `;
                grid.appendChild(card);
            });
        }

        function toggleAct2Selection(item) {
            playSound('click');
            const index = act2SelectedItems.findIndex(i => i.id === item.id);

            if (index > -1) {
                act2SelectedItems.splice(index, 1);
            } else {
                if (act2SelectedItems.length < 3) {
                    act2SelectedItems.push(item);
                    speakWord(item.word);
                } else {
                    showFeedbackToast(false, "You can only pick 3 items!");
                }
            }

            updateAct2SlotsUI();
            renderAct2Options();
        }

        function updateAct2SlotsUI() {
            const countEl = document.getElementById('act2-selected-count');
            const submitBtn = document.getElementById('act2-submit-btn');
            const previewEl = document.getElementById('act2-outfit-preview');
            const statusEl = document.getElementById('act2-char-status');

            countEl.innerText = act2SelectedItems.length;

            // Update slots
            for (let i = 0; i < 3; i++) {
                const slot = document.querySelector(`.slot-${i}`);
                if (act2SelectedItems[i]) {
                    slot.innerText = act2SelectedItems[i].emoji;
                    slot.classList.remove('border-dashed');
                    slot.classList.add('bg-white', 'border-amber-400');
                } else {
                    slot.innerText = "❓";
                    slot.classList.add('border-dashed');
                    slot.classList.remove('bg-white', 'border-amber-400');
                }
            }

            previewEl.innerHTML = act2SelectedItems.map(i => i.emoji).join('');

            if (act2SelectedItems.length === 3) {
                submitBtn.disabled = false;
                submitBtn.className = "px-8 py-3 bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-300 hover:to-teal-400 text-white font-black rounded-2xl text-lg shadow-xl cursor-pointer btn-bounce";
                statusEl.innerText = "Leo is ready! Tap Check Outfit!";
            } else {
                submitBtn.disabled = true;
                submitBtn.className = "px-8 py-3 bg-gray-300 text-gray-500 font-black rounded-2xl text-lg shadow-md cursor-not-allowed";
                statusEl.innerText = `Pick ${3 - act2SelectedItems.length} more item(s)...`;
            }
        }

        function checkAct2Outfit() {
            const allMatch = act2SelectedItems.every(i => i.category === act2Weather);

            if (allMatch) {
                showFeedbackToast(true, "Perfect! Leo has the right outfit!");
                act2SelectedItems.forEach(i => gameState.masteredWords.add(i.word));
                recordAnswer(true);
                setTimeout(finishActivity, 1500);
            } else {
                showFeedbackToast(false, "Some clothes don't fit this weather! Try again!");
                recordAnswer(false);
                // Clear selection for retry
                act2SelectedItems = [];
                updateAct2SlotsUI();
                renderAct2Options();
            }
        }


        /* ==================== ACTIVITY 3 LOGIC ==================== */
        function loadAct3Question() {
            const q = act3Questions[currentAct3Index];
            setTheme(q.weather);

            document.getElementById('act3-q-num').innerText = currentAct3Index + 1;
            document.getElementById('act3-q-total').innerText = act3Questions.length;

            const badge = document.getElementById('act3-weather-badge');
            if (q.weather === 'sunny') {
                badge.className = "px-3 py-1 bg-yellow-100 text-yellow-800 font-bold text-xs rounded-full";
                badge.innerText = "☀️ Sunny Weather";
            } else {
                badge.className = "px-3 py-1 bg-sky-100 text-sky-800 font-bold text-xs rounded-full";
                badge.innerText = "🌧️ Rainy Weather";
            }

            document.getElementById('act3-sentence').innerHTML = q.sentence.replace('____', `<span class="border-b-4 border-dashed border-amber-500 px-2 text-amber-600">______</span>`);

            // Options grid
            const optionsContainer = document.getElementById('act3-options');
            optionsContainer.innerHTML = '';

            const shuffledOpts = [...q.options].sort(() => Math.random() - 0.5);

            shuffledOpts.forEach(opt => {
                const btn = document.createElement('button');
                btn.onclick = () => selectAct3Option(opt, q);
                btn.className = "game-card bg-white p-4 rounded-2xl border-4 border-gray-100 hover:border-amber-300 flex flex-col items-center justify-center space-y-1";
                btn.innerHTML = `
                    <span class="text-4xl">${opt.emoji}</span>
                    <span class="font-extrabold text-gray-800 text-base">${opt.word}</span>
                `;
                optionsContainer.appendChild(btn);
            });

            speakAct3Question();
        }

        function speakAct3Question() {
            const q = act3Questions[currentAct3Index];
            speakWord(q.sentence.replace('____', 'blank'));
        }

        function selectAct3Option(option, question) {
            if (option.correct) {
                showFeedbackToast(true, `Great! "${option.word}" is correct!`);
                document.getElementById('act3-sentence').innerHTML = question.sentence.replace('____', `<span class="bg-yellow-200 px-3 py-1 rounded-xl text-amber-900 border-2 border-amber-400 font-black">${option.word}</span>`);
                gameState.masteredWords.add(option.word);
                recordAnswer(true);

                setTimeout(() => {
                    currentAct3Index++;
                    if (currentAct3Index < act3Questions.length) {
                        loadAct3Question();
                    } else {
                        finishActivity();
                    }
                }, 1500);
            } else {
                showFeedbackToast(false, `Not quite! ${option.word} isn't right here.`);
                recordAnswer(false, option.word);
            }
        }


        /* ==================== SUMMARY & TEACHER PANEL ==================== */
        function finishActivity() {
            playSound('fanfare');
            confetti({
                particleCount: 100,
                spread: 70,
                origin: { y: 0.6 }
            });

            setTheme('neutral');
            showView('view-summary');

            // Compute summary stats
            document.getElementById('summary-score').innerText = `${gameState.score} pts`;
            document.getElementById('summary-stars').innerText = `⭐ ${gameState.stars}`;

            const accuracy = gameState.totalAttempts > 0 
                ? Math.round((gameState.correctAttempts / gameState.totalAttempts) * 100) 
                : 100;
            document.getElementById('summary-accuracy').innerText = `${accuracy}%`;

            // Teacher Feedback logic
            const feedbackEl = document.getElementById('teacher-feedback-text');
            if (accuracy >= 85) {
                feedbackEl.innerText = "🌟 Outstanding Performance! The student demonstrates excellent English vocabulary comprehension for both Sunny and Rainy clothing items with fast recall.";
            } else if (accuracy >= 60) {
                feedbackEl.innerText = "👍 Good Progress! The student correctly identifies key clothing items. A little more repetition on rainy day vocabulary (e.g. Rain boots vs Sandals) will lock in mastery.";
            } else {
                feedbackEl.innerText = "💪 Encouraging Effort! Keep practicing! Focusing on listening to pronunciations in the quick-listen tool will help reinforce word associations.";
            }

            // Retried/Mastered list
            const retryBox = document.getElementById('retried-items-box');
            const wordsListEl = document.getElementById('retried-words-list');
            if (gameState.masteredWords.size > 0) {
                retryBox.classList.remove('hidden');
                wordsListEl.innerText = Array.from(gameState.masteredWords).join(', ');
            } else {
                retryBox.classList.add('hidden');
            }
        }

        function resetAppStats() {
            gameState.score = 0;
            gameState.stars = 0;
            gameState.streak = 0;
            gameState.totalAttempts = 0;
            gameState.correctAttempts = 0;
            gameState.incorrectQueue = [];
            gameState.masteredWords.clear();
            updateScoreBoard();
            goToHome();
        }

        // Initialize default view
        window.onload = function() {
            updateScoreBoard();
            setTheme('neutral');
        };
    </script>
</body>
</html>
