        <!-- ================= PAGE 2: ACTIVITY 1 - WEATHER SORTING ================= -->
        <section id="view-act1" class="hidden space-y-4">
            <!-- Header bar for activity -->
            <div class="flex items-center justify-between bg-white/80 p-3 rounded-2xl border-2 border-white">
                <button onclick="goToHome()" class="px-3 py-1 bg-gray-200 hover:bg-gray-300 rounded-xl font-bold text-xs text-gray-700 flex items-center space-x-1">
                    <i class="fa-solid fa-arrow-left"></i> <span>Menu</span>
                </button>
                <div class="text-center">
                    <h2 class="font-black text-lg text-gray-800">Activity 1: Weather Sorting 🧺</h2>
                    <p class="text-xs font-semibold text-gray-600">Classify clothes: Sunny ☀️ vs Rainy 🌧️</p>
                </div>
                <div class="text-xs font-bold text-amber-700 bg-amber-100 px-3 py-1 rounded-xl">
                    Remaining: <span id="act1-remaining">0</span>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="w-full bg-white/60 h-3 rounded-full overflow-hidden border border-white">
