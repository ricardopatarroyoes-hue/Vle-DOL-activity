<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather & Clothes Kids Adventure!</title>
    <!-- Tailwind CSS for utility styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti for celebrations -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Fredoka & Outfit for fun, child-friendly typography -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Fredoka', cursive, sans-serif;
            user-select: none;
            -webkit-user-select: none;
            transition: background-color 0.8s ease, border-color 0.8s ease;
        }

        /* Dynamic Theme Styles */
        .theme-sunny {
            background: linear-gradient(135deg, #FFFDE7 0%, #FFF59D 50%, #FFEE58 100%);
            color: #5D4037;
        }

        .theme-rainy {
            background: linear-gradient(135deg, #E1F5FE 0%, #B3E5FC 50%, #81D4FA 100%);
            color: #01579B;
        }

        .theme-neutral {
            background: linear-gradient(135deg, #FFF8E1 0%, #E0F7FA 100%);
            color: #37474F;
        }

        /* Card and Button Effects */
        .game-card {
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s ease;
            box-shadow: 0 8px 0 rgba(0,0,0,0.12);
        }

        .game-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 12px 0 rgba(0,0,0,0.15);
        }

        .game-card:active {
            transform: translateY(2px) scale(0.98);
            box-shadow: 0 4px 0 rgba(0,0,0,0.1);
        }

        .btn-bounce {
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-10px); }
            60% { transform: translateY(-5px); }
        }

        .pulse-subtle {
            animation: pulse-effect 1.8s infinite;
        }

        @keyframes pulse-effect {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        /* Custom Rain Effect for Rainy Mode */
        .rain-drop {
            position: absolute;
            background: rgba(255, 255, 255, 0.6);
            width: 2px;
            height: 14px;
            opacity: 0.7;
            pointer-events: none;
            animation: fall linear infinite;
        }

        @keyframes fall {
            to { transform: translateY(100vh); }
        }

        /* Custom Sun Ray Effect */
        .sun-ray {
            position: absolute;
            top: -50px;
            right: -50px;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(255,235,59,0.4) 0%, rgba(255,255,255,0) 70%);
            border-radius: 50%;
            pointer-events: none;
            animation: spin 20s linear infinite;
        }

        @keyframes spin {
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="theme-neutral min-h-screen flex flex-col justify-between overflow-x-hidden relative transition-all duration-700">

    <!-- Audio Elements Synth Generator using Web Audio API -->
    
    <!-- Sun Ray / Rain Overlay Containers -->
    <div id="rain-container" class="fixed inset-0 pointer-events-none hidden z-0"></div>
    <div id="sun-container" class="fixed top-0 right-0 pointer-events-none hidden z-0">
        <div class="sun-ray"></div>
    </div>

    <!-- Header Navigation Bar -->
    <header class="relative z-10 w-full max-w-5xl mx-auto px-4 pt-4 pb-2 flex flex-wrap justify-between items-center gap-3">
        <!-- Logo / Title -->
        <div class="flex items-center space-x-3 cursor-pointer" onclick="goToHome()">
            <div class="w-12 h-12 rounded-2xl bg-amber-400 border-4 border-white flex items-center justify-center text-2xl shadow-md">
                ☀️
            </div>
            <div>
                <h1 class="text-2xl font-extrabold tracking-wide drop-shadow-sm leading-tight">
                    Sunny & Rainy <span class="text-amber-600">Clothes!</span>
                </h1>
                <p class="text-xs font-semibold opacity-80">EFL Kids English Adventure 🎈</p>
            </div>
        </div>

        <!-- Gamification Score Board -->
        <div class="flex items-center gap-3 bg-white/80 backdrop-blur-md px-4 py-2 rounded-2xl border-2 border-white/60 shadow-md">
            <!-- Stars -->
            <div class="flex items-center space-x-1" title="Stars Collected">
                <i class="fa-solid fa-star text-amber-400 text-xl drop-shadow-sm"></i>
                <span id="star-count" class="font-black text-lg text-gray-800">0</span>
            </div>
            <div class="h-6 w-0.5 bg-gray-300"></div>
            <!-- Score Points -->
            <div class="flex items-center space-x-1" title="Total Score">
                <i class="fa-solid fa-trophy text-yellow-500 text-xl drop-shadow-sm"></i>
                <span id="score-count" class="font-black text-lg text-gray-800">0 pts</span>
            </div>
            <div class="h-6 w-0.5 bg-gray-300"></div>
            <!-- Streak Combo -->
            <div class="flex items-center space-x-1" title="Streak Combo">
