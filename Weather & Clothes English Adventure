            </div>

            <!-- Active Sorting Card -->
            <div id="act1-card-container" class="flex flex-col items-center justify-center py-2">
                <!-- Current item to sort -->
                <div id="act1-item" class="game-card bg-white p-6 rounded-3xl border-4 border-amber-300 shadow-xl text-center max-w-xs w-full cursor-grab active:cursor-grabbing transform transition-all">
                    <div id="act1-emoji" class="text-7xl mb-2 animate-bounce">👕</div>
                    <div id="act1-title" class="text-2xl font-black text-gray-800">T-shirt</div>
                    <button onclick="speakWord(currentAct1Item.word)" class="mt-2 px-3 py-1 bg-amber-100 hover:bg-amber-200 rounded-full text-xs font-bold text-amber-800 flex items-center justify-center mx-auto space-x-1">
