    <!-- Main App Container -->
    <main class="relative z-10 w-full max-w-4xl mx-auto px-4 my-auto py-4 flex-grow flex flex-col justify-center">

        <!-- ================= PAGE 1: HOME MENU ================= -->
        <section id="view-home" class="block space-y-6 text-center">
