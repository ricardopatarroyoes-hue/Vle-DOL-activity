            </div>

            <!-- Target Buckets Grid -->
            <div class="grid grid-cols-2 gap-4 max-w-2xl mx-auto pt-2">
                <!-- Sunny Bucket -->
                <button onclick="sortItem('sunny')" class="game-card bg-gradient-to-b from-yellow-200 to-amber-300 border-4 border-yellow-400 p-4 rounded-3xl text-center flex flex-col items-center justify-center space-y-2 group hover:bg-yellow-300">
